# Копировать в backend/.env (локально) или /etc/twc/backend.env (VPS)
DATABASE_URL=postgresql+asyncpg://twc:twc@127.0.0.1:5432/twc
APP_HOST=127.0.0.1
APP_PORT=3000
# Через запятую. Для прода — домен сайта.
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4000
# Секрет подписи JWT админки: openssl rand -hex 32
JWT_SECRET=change-me
JWT_TTL_HOURS=12
